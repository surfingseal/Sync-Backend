PORT=8080
APP_ENV=development
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=graduation-exhibition-510404
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_MODEL=gemini-3.8-flash
VERTEX_TIMEOUT_SECONDS=20
IMAGE_MAX_DIMENSION=1920
IMAGE_HARD_MAX_BYTES=6291456
YOUTUBE_API_KEY=
YOUTUBE_REGION=KR
YOUTUBE_RELEVANCE_LANGUAGE=ko
RECOMMENDATION_COUNT=10
YOUTUBE_SEARCH_QUERY_COUNT=2

# User YouTube OAuth: separate from Vertex ADC and the public-search API key.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube
OAUTH_COOKIE_SECURE=false
OAUTH_FORCE_CONSENT=true

# Baseline preserved until benchmark quality acceptance.
VERTEX_THINKING_LEVEL=MEDIUM
VERTEX_RETRY_MODE=sdk
VERTEX_RETRY_ATTEMPTS=3
# Opt-in deadline-aware experiment: budget + attempts=2 (SDK attempts=1 internally).

# Recommendation V2 (Gemini retained pending blind query review)
RECOMMENDATION_RANKER=v2
RECOMMENDATION_QUERY_MODE=deterministic

# Deterministic query language keywords; default true (production mode unchanged).
RECOMMENDATION_QUERY_LANGUAGE_KEYWORDS=true

# Offline recommendation development; does not disable image analysis or OAuth.
RECOMMENDATION_DATA_MODE=fixture
RECOMMENDATION_REPLAY_PATH=
YOUTUBE_LIVE_SEARCH_ENABLED=false
YOUTUBE_SEARCH_MAX_CALLS_PER_RUN=10
YOUTUBE_SEARCH_CACHE_TTL_SECONDS=300
RECOMMENDATION_ADAPTIVE_SAFETY_MARGIN=3

# Retrieval v2: 1–50 results per search, no pagination.
YOUTUBE_SEARCH_MAX_RESULTS=50
# mixed: song or music; vocal-first uses song, instrumental modes use music.
RECOMMENDATION_MIXED_QUERY_KEYWORD=song

# v4 neutral retrieval / release gate (affinity and confidence are heuristics).
RECOMMENDATION_Q1_ORDER=relevance
RECOMMENDATION_Q2_POPULARITY_ORDER=viewCount
RECOMMENDATION_MIN_MEDIUM_ESTABLISHED=6
RECOMMENDATION_REQUIRE_RELEASE_CONFIDENCE=true
RECOMMENDATION_ALLOWED_RELEASE_CONFIDENCE=HIGH,MEDIUM
RECOMMENDATION_MIN_LANGUAGE_COVERAGE_PER_PREFERENCE=2

# Audit CLI only; the API server does not require this key.
LASTFM_API_KEY=

# Explicit opt-in: gemini_direct enables the separate multipart API.
# Requires live data mode, enabled YouTube search, valid Vertex ADC and API key.
RECOMMENDATION_ENGINE=legacy

# Local historical cmd/direct-e2e-server only; Direct MVP target is 5.
# This does not enable the production Direct engine.
DIRECT_E2E_FINAL_TRACK_LIMIT=5

# Optional native OAuth handoff. Missing/invalid values disable this feature only.
# Must match the HTTPS origin of GOOGLE_OAUTH_REDIRECT_URL.
MOBILE_APP_LINK_BASE_URL=https://sync-backend-c2lv.onrender.com
# Supply the real Android applicationId and signing certificate (Play App Signing
# certificate for Play-distributed builds). Never deploy placeholder values.
ANDROID_PACKAGE_NAME=
ANDROID_APP_SIGNING_SHA256=
